<Window x:Class="CronoAula.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CronoAula"
        Icon="Assets/cronoaula.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource FundoDialogo}">

    <!-- Janela de exibição: só o relógio, para a turma ver.
         Fundo verde profundo da marca, sem transparência: é a cor prevista no
         manual para fundo escuro e rende 13,7 de contraste com os dígitos. -->
    <Grid>
        <Viewbox Stretch="Uniform" Margin="60,40,60,80">
            <TextBlock x:Name="Mostrador"
                       Text="00:00"
                       FontFamily="Consolas"
                       FontWeight="Bold"
                       Foreground="{StaticResource AlertaNormal}"
                       TextAlignment="Center"/>
        </Viewbox>

        <!-- Nome da faixa de alerta em texto. O manual proíbe indicar estado
             apenas por cor, e da última fileira da sala a diferença entre os
             tons de laranja não é confiável. -->
        <Viewbox Stretch="Uniform" MaxHeight="46"
                 VerticalAlignment="Bottom" HorizontalAlignment="Center"
                 Margin="0,0,0,26">
            <TextBlock x:Name="RotuloEstado"
                       Text=""
                       FontFamily="Segoe UI"
                       Foreground="{StaticResource TextoSecundario}"
                       TextAlignment="Center"/>
        </Viewbox>

        <!-- Controles de emergência: só aparecem com um monitor, quando não há
             painel de controle em outra tela. Somem sozinhos após alguns
             segundos para não poluir a projeção. -->
        <Border x:Name="Controles"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,34,34"
                Background="{StaticResource BarraFlutuante}"
                CornerRadius="10"
                Padding="10,8"
                Opacity="0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BotaoPrimario" Content="Iniciar" Click="BotaoPrimario_Click"
                        Background="{StaticResource BotaoPrincipalFundo}"
                        Foreground="{StaticResource BotaoPrincipalTexto}" BorderThickness="0"
                        Padding="14,6" Margin="3,0" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Zerar" Click="BotaoZerar_Click"
                        Background="{StaticResource VerdeMedio}"
                        Foreground="{StaticResource Branco}" BorderThickness="0"
                        Padding="14,6" Margin="3,0" Cursor="Hand"/>
                <Button Content="+1 min" Click="BotaoMaisUm_Click"
                        Background="{StaticResource VerdeMedio}"
                        Foreground="{StaticResource Branco}" BorderThickness="0"
                        Padding="14,6" Margin="3,0" Cursor="Hand"/>
                <Button Content="Sair da tela cheia (Esc)" Click="BotaoSair_Click"
                        Background="{StaticResource VerdeMedio}"
                        Foreground="{StaticResource Branco}" BorderThickness="0"
                        Padding="14,6" Margin="3,0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
