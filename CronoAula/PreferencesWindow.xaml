<Window x:Class="CronoAula.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CronoAula - Preferências"
        Icon="Assets/cronoaula.ico"
        SizeToContent="Height"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF1F1F23"
        Foreground="#FFEDEDED"
        FontFamily="Segoe UI"
        FontSize="12"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2A2A30"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFEDEDED"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E2E33"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8AA4FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Dica" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9AA0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,14">

        <!-- Som -->
        <TextBlock Text="Som" Style="{StaticResource Secao}"/>
        <CheckBox x:Name="ChkSom" Content="Tocar sinal sonoro ao terminar" Margin="0,0,0,0"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Volume" Margin="0,0,8,0"/>
            <Slider x:Name="SliderVolume" Grid.Column="1" Minimum="0" Maximum="1"
                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <TextBlock x:Name="LblVolume" Grid.Column="2" Text="70%" Width="38"
                       TextAlignment="Right" Margin="8,0,0,0"/>
        </Grid>

        <!-- Insistencia do alerta de fim -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Repetir" Margin="0,0,6,0"/>
            <TextBox   Grid.Column="1" x:Name="CampoRepeticoes"/>
            <TextBlock Grid.Column="2" Text="vezes, a cada" Margin="6,0,6,0"/>
            <TextBox   Grid.Column="3" x:Name="CampoIntervalo"/>
            <TextBlock Grid.Column="4" Text="segundos" Margin="6,0,0,0"/>
        </Grid>
        <TextBlock Style="{StaticResource Dica}"
                   Text="Com 0 repetições, o alerta toca até você mexer no cronômetro. Um clique na janela, um botão ou um atalho já silencia."/>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Testar alerta de fim" Click="TestarAlerta_Click" Margin="0,0,0,0"/>
            <Button Content="Testar aviso antecipado" Click="TestarAviso_Click"/>
            <Button Content="Parar" Click="PararSom_Click"/>
        </StackPanel>

        <!-- Contagem -->
        <TextBlock Text="Contagem" Style="{StaticResource Secao}"/>
        <CheckBox x:Name="ChkNegativo" Content="Continuar contando em negativo após o zero"/>
        <TextBlock Style="{StaticResource Dica}"
                   Text="Se estiver desligado, o cronômetro para em 00:00."/>

        <CheckBox x:Name="ChkAvisoAntecipado" Content="Avisar antes de terminar"/>
        <Grid Margin="22,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Faltando" Margin="0,0,6,0"/>
            <TextBox   Grid.Column="1" x:Name="CampoAvisoMinutos"/>
            <TextBlock Grid.Column="2" Text="minutos" Margin="6,0,0,0"/>
        </Grid>

        <!-- Presets -->
        <TextBlock Text="Tempos rápidos" Style="{StaticResource Secao}"/>
        <TextBox x:Name="CampoPresets"/>
        <TextBlock Style="{StaticResource Dica}"
                   Text="Escreva os minutos separados por vírgula, até seis. Por exemplo: 5, 10, 15, 30, 50"/>

        <!-- Atalhos -->
        <TextBlock Text="Atalhos globais" Style="{StaticResource Secao}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Iniciar / Pausar"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="CampoAtalhoIniciar"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Zerar"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CampoAtalhoZerar"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Somar 1 minuto"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="CampoAtalhoMais"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Subtrair 1 minuto"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="CampoAtalhoMenos"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Mostrar / Esconder"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="CampoAtalhoMostrar"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Tela cheia"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="CampoAtalhoTelaCheia"/>
        </Grid>
        <TextBlock Style="{StaticResource Dica}"
                   Text="Escreva no formato Ctrl+Alt+S, Ctrl+Shift+F9 ou Ctrl+Alt+Up. Deixe o campo vazio para desligar um atalho."/>

        <!-- Rodape -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Restaurar padrões" Click="Restaurar_Click"/>
            <Button Content="Cancelar" Click="Cancelar_Click"/>
            <Button Content="Salvar" Click="Salvar_Click" Background="#FF4C6EF5" FontWeight="SemiBold"/>
        </StackPanel>

    </StackPanel>
</Window>
